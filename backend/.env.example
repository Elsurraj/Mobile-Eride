# E-Ride Backend Environment Configuration

# Server Configuration
PORT=8000
NODE_ENV=development

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DATABASE_PATH=./eride.db

# Email Configuration for OTP Sending
# To enable email OTP sending, follow these steps:
# 
# 1. Use a Gmail account (or update the service in server.js for other providers)
# 2. Enable 2-Factor Authentication on your Gmail account
# 3. Generate an "App Password" in your Google Account settings
# 4. Replace the values below with your actual Gmail credentials
#
# Instructions to get Gmail App Password:
# 1. Go to https://myaccount.google.com/
# 2. Click on "Security" in the left sidebar
# 3. Under "Signing in to Google", click "2-Step Verification" (enable if not already)
# 4. At the bottom of the page, click "App passwords"
# 5. Select "Mail" and your device, then generate a password
# 6. Use that generated password (not your regular Gmail password) below

EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-app-password

# CORS Origins (add your frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# Example with real values (replace with your actual credentials):
# EMAIL_USER=johndoe@gmail.com  
# EMAIL_PASS=abcd efgh ijkl mnop  (16-character app password from Google)
